{
  "printWidth": 120,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "bracketSpacing": true,
  "trailingComma": "es5",
  "bracketSameLine": false,
  "jsxSingleQuote": true,
  "endOfLine": "auto",
  "experimentalTernaries": false,
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ".eslintrc",
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
